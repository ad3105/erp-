# ─────────────────────────────────────────────────────────────
# Supabase configuration
# Copy this file to ".env" and fill in the values from your
# Supabase project  →  Settings  →  API
# ─────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public "anon" key (safe to expose in the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# NOTE: The site runs WITHOUT these values using built-in demo
# content, so you can preview it immediately. Fill them in to
# enable login + persistent admin editing.
# ─────────────────────────────────────────────────────────────
